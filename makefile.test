testclean: .SYMBOLIC
    @if exist tm_*.obj del tm_*.obj
    @if exist t_*.obj del t_*.obj
    @if exist test_*.exe del test_*.exe
    @if exist test_*.log del test_*.log
    @if exist testpass.txt del testpass.txt
    @if exist testfail.txt del testfail.txt
    @if exist testnobld.txt del testnobld.txt
