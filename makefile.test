#====================================================================
# Unit tests, built as OS/2 ring-3 programs (no driver, no hardware).
#   wmake -f makefile.wat test          build, run and summarise every test
#   wmake -f makefile.wat testbuild     build the tests only
#   wmake -f makefile.wat run_test_bar  build and run one test
#   wmake -f makefile.wat test_bar.exe  build one test
#   wmake -f makefile.wat testclean     delete test programs, logs, results
# A test that fails to compile or link is reported as NOT BUILT and the
# remaining tests still run. Each test writes test_NAME.log.
# Insert this block before the Housekeeping section. It uses WATCOM, CC,
# LINK and OS2TK_LIB from earlier in the file.
# Never define NDEBUG for these: the tests call the code under test
# inside assert().
#====================================================================
CC = wcc386
LINK = wlink
OS2TK_LIB = E:\OS2TK45\LIB
INC_T = -i=include -i=tests -i=$(WATCOM)\h
CF_T  = -q -bt=os2 -zq -w3 -6s -zp4 -d__OS2__ -bm -od -d1 $(INC_T)
TCC   = $(CC) $(CF_T)
TCORE_OBJS = t_devices.obj t_crc32.obj t_fw_stream.obj t_fw_image.obj &
              t_fw_loader.obj t_transport.obj t_bar.obj t_hw.obj &
              t_rings.obj t_genmac.obj t_ndis.obj t_os2ioctl.obj t_os2adapter.obj
TEST_EXES = test_core.exe test_fw_fixes.exe test_fw_image.exe test_transport.exe &
            test_oid.exe test_os2_adapter.exe test_bar.exe test_fw_loader.exe
RUN_TESTS = run_test_core run_test_fw_fixes run_test_fw_image run_test_transport &
            run_test_oid run_test_os2_adapter run_test_bar run_test_fw_loader
testbuild: .SYMBOLIC $(TEST_EXES)
testinit: .SYMBOLIC
    @if exist testpass.txt del testpass.txt
    @if exist testfail.txt del testfail.txt
    @if exist testnobld.txt del testnobld.txt
test: .SYMBOLIC testinit $(RUN_TESTS)
    @echo ===== test summary =====
    @echo PASSED:
    @if exist testpass.txt type testpass.txt
    @if not exist testpass.txt echo   (none)
    @echo FAILED (read test_NAME.log):
    @if exist testfail.txt type testfail.txt
    @if not exist testfail.txt echo   (none)
    @echo NOT BUILT (compiler or linker errors are shown above):
    @if exist testnobld.txt type testnobld.txt
    @if not exist testnobld.txt echo   (none)
    @if exist testfail.txt echo RESULT: some tests FAILED
    @if exist testnobld.txt echo RESULT: some tests did NOT BUILD
    @if not exist testfail.txt if not exist testnobld.txt echo RESULT: ALL TESTS PASSED
#--------------------------------------------------------------------
# Portable core and OS/2 glue, compiled for ring 3 (no IWM_RING0)
#--------------------------------------------------------------------
t_devices.obj: core\iwm_devices.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_devices.c
t_crc32.obj: core\iwm_crc32.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_crc32.c
t_fw_stream.obj: core\iwm_fw_stream.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_fw_stream.c
t_fw_image.obj: core\iwm_fw_image.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_fw_image.c
t_fw_loader.obj: core\iwm_fw_loader.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_fw_loader.c
t_transport.obj: core\iwm_transport.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_transport.c
t_bar.obj: core\iwm_bar.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_bar.c
t_hw.obj: core\iwm_hw.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_hw.c
t_rings.obj: core\iwm_rings.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_rings.c
t_genmac.obj: core\iwm_genmac.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_genmac.c
t_ndis.obj: core\iwm_ndis.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ core\iwm_ndis.c
t_os2ioctl.obj: os2\iwm_os2_ioctl.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ os2\iwm_os2_ioctl.c
t_os2adapter.obj: os2\iwm_os2_adapter.c .AUTODEPEND
    @if exist $@ del $@
    -$(TCC) -fo=$@ os2\iwm_os2_adapter.c
#--------------------------------------------------------------------
# One program per test: main object + the core objects above
#--------------------------------------------------------------------
tm_core.obj: tests\test_core.c .AUTODEPEND
    @if exist $@ del $@
    @if exist test_core.exe del test_core.exe
    -$(TCC) -fo=$@ tests\test_core.c
test_core.exe: tm_core.obj $(TCORE_OBJS)
    @if exist $@ del $@
    -$(LINK) name $@ system os2v2 option quiet,stack=128k file { tm_core.obj $(TCORE_OBJS) } libpath $(OS2TK_LIB)
run_test_core: .SYMBOLIC test_core.exe
    @if exist test_core.log del test_core.log
    @if exist test_core.exe test_core.exe > test_core.log 2>&1 && echo test_core>> testpass.txt || echo test_core>> testfail.txt
    @if not exist test_core.exe echo test_core>> testnobld.txt
    @if exist test_core.log type test_core.log
tm_fw_fixes.obj: tests\test_fw_fixes.c .AUTODEPEND
    @if exist $@ del $@
    @if exist test_fw_fixes.exe del test_fw_fixes.exe
    -$(TCC) -fo=$@ tests\test_fw_fixes.c
test_fw_fixes.exe: tm_fw_fixes.obj $(TCORE_OBJS)
